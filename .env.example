# Semantic Scholar API Key (Free tier key: 1 req/sec guaranteed)
# Đăng ký tại: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Hugging Face User Access Token (Quyền write để upload dataset cá nhân)
# Tạo token tại: https://huggingface.co/settings/tokens
HF_TOKEN=

# Contact Email for arXiv API crawler etiquette (Bắt buộc trong User-Agent)
ARXIV_CONTACT_EMAIL=thongpham796@gmail.com

# Pipeline Runtime Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
